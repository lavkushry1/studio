// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  password      String
  name          String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organizedEvents Event[] @relation("OrganizedBy")
  bookings      Booking[]
  refreshTokens RefreshToken[] // Relation to refresh tokens
}

// Enum for User Roles
enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

// Refresh Token Model
model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   // Store the token ID, not the JWT itself
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // Expiration date of the token
  createdAt DateTime @default(now())

  @@index([userId])
}


// Event Model
model Event {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  category      String?  // Added category field
  date          DateTime
  location      String
  imageUrl      String?
  status        EventStatus @default(DRAFT)
  organizerId   String   @db.ObjectId
  organizer     User     @relation("OrganizedBy", fields: [organizerId], references: [id])
  ticketCategories TicketCategory[]
  bookings      Booking[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Add index for commonly filtered fields
  @@index([date])
  @@index([location])
  @@index([status])
  @@index([category]) // Index for category filtering
  @@index([organizerId])

  // Add text index for search
  @@fulltext([title, description, location, category])
}

// Enum for Event Status
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// Ticket Category Model (related to Event)
model TicketCategory {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  price         Float
  totalQty      Int
  bookedQty     Int      @default(0) // Track booked tickets for this category
  eventId       String   @db.ObjectId
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId])
}

// Booking Model
model Booking {
    id             String        @id @default(auto()) @map("_id") @db.ObjectId
    userId         String?       @db.ObjectId // Optional: Link to User if logged in
    user           User?         @relation(fields: [userId], references: [id])
    eventId        String        @db.ObjectId
    event          Event         @relation(fields: [eventId], references: [id])
    // ticketCategoryId String?    @db.ObjectId // Optional: Link to specific category if needed
    quantity       Int
    totalPrice     Float
    status         BookingStatus @default(PENDING)
    deliveryName   String?       // Added for delivery details
    deliveryEmail  String?       // Added for delivery details
    deliveryPhone  String?       // Added for delivery details
    utr            String?       @unique // UPI Transaction Reference
    paymentVerifiedAt DateTime?   // Timestamp when admin verified payment
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@index([userId])
    @@index([eventId])
    @@index([status])
    @@index([utr])
}

// Enum for Booking Status
enum BookingStatus {
  PENDING      // Initial state, awaiting payment/UTR
  PROCESSING   // UTR submitted, awaiting admin verification
  CONFIRMED    // Payment verified, ticket issued (or ready to be)
  CANCELLED    // Booking cancelled by user or system
  FAILED       // Payment failed or rejected by admin
}

// Consider adding models for:
// - Venues/Stadiums (if seat mapping is complex)
// - Discounts/Promotions
// - Payments (separate log if more detail needed than in Booking)
// - Audit Logs

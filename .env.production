# .env.production
# Use environment variables provided by your hosting platform in production.
# This file is mainly for reference or local production testing.

# Application Port (Set by hosting platform, e.g., Cloud Run)
# PORT=8080

# Database Connection URL (Provided by hosting or DB service)
DATABASE_URL="YOUR_PRODUCTION_DATABASE_URL"

# JWT Secrets (Use strong, randomly generated secrets stored securely, e.g., Secret Manager)
ACCESS_TOKEN_SECRET="YOUR_STRONG_PRODUCTION_ACCESS_SECRET"
REFRESH_TOKEN_SECRET="YOUR_STRONG_PRODUCTION_REFRESH_SECRET"

# JWT Expiration Times (Adjust as needed for production)
# ACCESS_TOKEN_EXPIRATION="10m"
# REFRESH_TOKEN_EXPIRATION="30d"

NODE_ENV=production

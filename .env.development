# Database (Example for PostgreSQL - adjust if using MongoDB/MySQL)
# DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
DATABASE_URL="mongodb://localhost:27017/ticketflow" # Example MongoDB URL

# JWT Secrets (Generate strong random secrets!)
ACCESS_TOKEN_SECRET="your_super_secret_access_token_key_dev_CHANGE_ME"
REFRESH_TOKEN_SECRET="your_super_secret_refresh_token_key_dev_CHANGE_ME"
ACCESS_TOKEN_EXPIRATION="15m"  # Example: 15 minutes
REFRESH_TOKEN_EXPIRATION="7d" # Example: 7 days

# Backend Port
PORT=3001

# Frontend Port (Handled by `next dev -p`)
# NEXT_PUBLIC_BASE_URL="http://localhost:9002" # Frontend Base URL

# Seat/Booking Timeouts (in minutes)
SEAT_RESERVATION_TIMEOUT_MINUTES=15
BOOKING_TIMEOUT_MINUTES=15

# Add other necessary variables (e.g., GenAI API Key)
# GOOGLE_GENAI_API_KEY=...

# --- Email Configuration ---
EMAIL_HOST="smtp.example.com" # Replace with your SMTP host (e.g., smtp.gmail.com, smtp.sendgrid.net)
EMAIL_PORT=587                # Common port for TLS (or 465 for SSL)
EMAIL_USER="your-email@example.com" # Your SMTP username
EMAIL_PASS="your-password-or-app-key" # Your SMTP password or app-specific key
EMAIL_FROM='"TicketFlow" <noreply@example.com>' # Default sender address

# --- Security Configuration ---
QR_CODE_SECRET="a-very-secret-string-for-qr-validation-CHANGE-ME" # Strong random secret for QR code validation

# --- Base URL Configuration ---
# Used for generating links in emails, QR codes etc.
NEXT_PUBLIC_BASE_URL="http://localhost:9002" # Your frontend URL
TICKET_VALIDATION_BASE_URL="http://localhost:9002/validate" # URL for QR code links (can be same as frontend)

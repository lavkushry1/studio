# Database (Replace with your Production Database URL)
DATABASE_URL="YOUR_PRODUCTION_DATABASE_URL"

# JWT Secrets (Generate STRONG, RANDOM secrets for production!)
ACCESS_TOKEN_SECRET="GENERATE_A_STRONG_RANDOM_ACCESS_SECRET_FOR_PRODUCTION"
REFRESH_TOKEN_SECRET="GENERATE_A_STRONG_RANDOM_REFRESH_SECRET_FOR_PRODUCTION"
ACCESS_TOKEN_EXPIRATION="15m"  # Adjust as needed
REFRESH_TOKEN_EXPIRATION="7d" # Adjust as needed

# Backend Port (Your production server will likely handle this, e.g., via PORT env var)
PORT=3001 # Or typically process.env.PORT provided by hosting platform

# Frontend Port (Handled by Next.js start script or hosting platform)
# NEXT_PUBLIC_BASE_URL="https://yourdomain.com" # Your Production Frontend URL

# Seat/Booking Timeouts (in minutes)
SEAT_RESERVATION_TIMEOUT_MINUTES=10 # Maybe shorter in production?
BOOKING_TIMEOUT_MINUTES=10

# Add other necessary variables (e.g., GenAI API Key)
# GOOGLE_GENAI_API_KEY=YOUR_PRODUCTION_API_KEY

# --- Email Configuration (Production) ---
EMAIL_HOST="YOUR_PRODUCTION_SMTP_HOST" # e.g., smtp.sendgrid.net
EMAIL_PORT=587                # Or 465 if using SSL
EMAIL_USER="YOUR_PRODUCTION_SMTP_USER" # Your SendGrid username, Mailgun SMTP user, etc.
EMAIL_PASS="YOUR_PRODUCTION_SMTP_PASSWORD_OR_API_KEY"
EMAIL_FROM='"TicketFlow" <noreply@yourdomain.com>' # Use your domain

# --- Security Configuration (Production) ---
QR_CODE_SECRET="GENERATE_A_VERY_STRONG_RANDOM_SECRET_FOR_PRODUCTION_QR_CODES"

# --- Base URL Configuration (Production) ---
NEXT_PUBLIC_BASE_URL="https://yourdomain.com" # Your Production Frontend URL
TICKET_VALIDATION_BASE_URL="https://yourdomain.com/validate" # Your Production Validation URL

# --- Node Environment ---
NODE_ENV=production

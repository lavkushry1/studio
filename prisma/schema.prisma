// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enum for User Roles
enum UserRole {
  USER
  ADMIN
  ORGANIZER // Added Organizer role
}

// User Model
model User {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  email           String        @unique
  password        String
  name            String?
  role            UserRole      @default(USER)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organizedEvents Event[]       @relation("OrganizedBy") // Events organized by this user
  bookings        Booking[] // Bookings made by this user
  refreshTokens   RefreshToken[] // User's refresh tokens
  auditLogs       AuditLog[] // Logs initiated by this user
}

// Refresh Token Model (for JWT refresh strategy)
model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String? // Can be null or store a reference/hashed version. Not storing raw JWT.
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Enum for Event Status
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// Event Model
model Event {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  description       String
  category          String? // Added category field
  date              DateTime
  location          String
  imageUrl          String?
  status            EventStatus      @default(DRAFT)
  hasSeatMap        Boolean          @default(false) // Flag for seat map UI
  organizerId       String           @db.ObjectId
  organizer         User             @relation("OrganizedBy", fields: [organizerId], references: [id])
  ticketCategories  TicketCategory[]
  seats             Seat[] // Seats associated with this event
  bookings          Booking[] // Bookings for this event
  teamId            String?          @db.ObjectId // Optional link to a Team
  team              Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull) // Relation to Team
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([organizerId])
  @@index([date])
  @@index([location])
  @@index([category]) // Added index for category
  @@index([status])
  @@index([teamId]) // Added index for teamId

  // Add text index for searching across multiple fields
  @@fulltext([title, description, location, category])
}

// Ticket Category Model (related to Event)
model TicketCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   // e.g., "General Admission", "VIP", "Early Bird"
  price     Float
  totalQty  Int // Total available tickets in this category
  bookedQty Int    @default(0) // Number of tickets booked in this category
  eventId   String   @db.ObjectId
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// Enum for Seat Status
enum SeatStatus {
  AVAILABLE
  RESERVED // Temporarily held during booking process
  BOOKED // Confirmed booking
  UNAVAILABLE // Blocked by organizer
}

// Seat Model (related to Event)
model Seat {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  row        String // e.g., "A", "B", "1", "2"
  number     Int // Seat number within the row
  section    String? // Optional: e.g., "North Stand", "Block C"
  status     SeatStatus  @default(AVAILABLE)
  eventId    String      @db.ObjectId
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingId  String?     @db.ObjectId // Link to the booking if booked
  booking    Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  ticketId   String?     @unique @db.ObjectId // Link to the generated ticket for this seat
  ticket     Ticket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  reservedAt DateTime? // Timestamp when the seat was reserved (for timeout)
  price      Float? // Optional price override for specific seats (e.g., premium view)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([eventId])
  @@index([eventId, status]) // For querying available seats quickly
  @@index([eventId, section, row, number], name: "event_seat_identifier") // Unique identifier within event
  @@index([bookingId])
}

// Enum for Booking Status
enum BookingStatus {
  PENDING // Initial state, awaiting payment details
  PROCESSING // UTR submitted, awaiting admin verification
  CONFIRMED // Payment verified, tickets issued/ready
  CANCELLED // Booking cancelled by user or system (timeout)
  FAILED // Payment failed or rejected by admin
  ERROR // Added for issues during ticket generation etc.
}

// Booking Model
model Booking {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String?       @db.ObjectId // Optional: Link to registered user
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventId           String        @db.ObjectId
  event             Event         @relation(fields: [eventId], references: [id])
  quantity          Int // Number of tickets/seats booked
  totalPrice        Float
  status            BookingStatus @default(PENDING)
  deliveryName      String? // Name provided during checkout
  deliveryEmail     String? // Email provided during checkout
  deliveryPhone     String? // Phone provided during checkout
  utr               String?       @unique // Unique Transaction Reference for UPI
  paymentVerifiedAt DateTime? // Timestamp when admin verified the payment
  seats             Seat[] // Seats included in this booking
  tickets           Ticket[] // Tickets generated for this booking
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

// Ticket Model (generated after confirmed booking)
model Ticket {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String    @db.ObjectId
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  eventId     String    @db.ObjectId // Store event ID directly on ticket
  eventTitle  String // Denormalized for easier display on ticket
  eventDate   DateTime // Denormalized
  seatId      String?   @unique @db.ObjectId // If this ticket is for a specific seat
  seat        Seat? // Relation back to the Seat
  qrData      String    @unique // Unique data to be encoded in the QR code
  isUsed      Boolean   @default(false) // Has the ticket been scanned/used for entry?
  usedAt      DateTime? // Timestamp when the ticket was used
  generatedAt DateTime  @default(now()) // When the ticket record was created
  emailedAt   DateTime? // Timestamp when the ticket email was sent

  @@index([bookingId])
  @@index([eventId])
  @@index([seatId])
}

// UPI Settings Model (Admin managed)
model UpiSetting {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  upiId    String   @unique // The UPI ID (VPA)
  isActive Boolean  @default(false)
  // updatedByAdminId String? // Optional: Track which admin last updated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Audit Log Model
model AuditLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  action        String // e.g., "Payment Approved", "Booking Cancelled", "Setting Updated"
  entity        String // e.g., "Booking", "UpiSetting", "Ticket"
  entityId      String // ID of the affected entity
  userId        String // ID of the user performing the action (or "SYSTEM")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull) // Optional relation back to user
  timestamp     DateTime @default(now())
  details       String? // Additional details about the action
  previousValue Json? // Store previous state (e.g., old status)
  newValue      Json? // Store new state (e.g., new status)

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([timestamp])
}

// Team Model (for IPL specific features)
model Team {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String   @unique // Full team name (e.g., "Mumbai Indians")
  shortName     String   @unique // Short code (e.g., "MI")
  logoUrl       String?  // URL to the team logo
  primaryColor  String?  // Hex code for primary color (e.g., "#004BA0")
  secondaryColor String? // Hex code for secondary color (e.g., "#D1AB3E")
  colorAccent   String? // Hex code for accent color
  events        Event[]  // Events associated with this team
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

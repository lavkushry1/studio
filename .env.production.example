# .env.production.example
# Copy this file to .env.production and fill in your actual production values
# Do NOT commit .env.production to version control!

# Backend Configuration
PORT=3001
DATABASE_URL="mongodb+srv://<user>:<password>@<your-atlas-cluster-url>/<database_name>?retryWrites=true&w=majority" # MongoDB Atlas URL

# JWT Secrets (Generate strong, random secrets for production!)
ACCESS_TOKEN_SECRET="your_very_strong_production_access_secret"
REFRESH_TOKEN_SECRET="your_very_strong_production_refresh_secret"
ACCESS_TOKEN_EXPIRATION="15m" # e.g., 15 minutes
REFRESH_TOKEN_EXPIRATION="30d" # e.g., 30 days

# Frontend Configuration (Build-time variables if using ARG in Dockerfile)
# Or runtime variables if read by the server/client differently
# NEXT_PUBLIC_API_URL="https://your-backend-api.com/api" # URL of your deployed backend
NEXT_PUBLIC_BASE_URL="https://your-frontend-domain.com" # URL of your deployed frontend

# Email Service (e.g., SendGrid, Mailgun)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey # Often 'apikey' for services like SendGrid
EMAIL_PASS="your_email_provider_api_key"
EMAIL_FROM="TicketFlow <noreply@yourdomain.com>" # Use your domain

# Security
QR_CODE_SECRET="another_very_strong_random_secret_for_qr" # For QR code signing

# PWA / Caching / Timeouts (Optional overrides)
# SEAT_RESERVATION_TIMEOUT_MINUTES=15
# BOOKING_TIMEOUT_MINUTES=15
# CACHE_DURATION_SECONDS=60 # For Redis cache if enabled

# Redis URL (Optional - if using Redis for caching/sessions)
# REDIS_URL="redis://your_redis_host:6379"

# Add any other production-specific variables needed by your app
# e.g., CDN URLs, third-party API keys

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Or your chosen provider: "mysql", "sqlite", "sqlserver", "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  password      String
  name          String?
  role          UserRole      @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  refreshTokens RefreshToken[]
  organizedEvents Event[]    @relation("OrganizedBy") // Events organized by this user
  bookings      Booking[]
}

enum UserRole {
  USER
  ADMIN
  ORGANIZER // Added Organizer role
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique // Store a hash or unique identifier, not the raw token
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// New Event Model
model Event {
  id               String           @id @default(cuid())
  title            String
  description      String
  date             DateTime // Stores both date and time
  location         String
  imageUrl         String?          // URL to the event image
  status           EventStatus      @default(DRAFT)
  organizerId      String
  organizer        User             @relation("OrganizedBy", fields: [organizerId], references: [id])
  ticketCategories TicketCategory[]
  bookings         Booking[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizerId])
  @@index([date])
}

// New Ticket Category Model
model TicketCategory {
  id        String   @id @default(cuid())
  name      String   // e.g., "General Admission", "VIP"
  price     Float
  totalQty  Int      // Total quantity available for this category
  bookedQty Int      @default(0) // Number of tickets booked in this category
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// New Booking Model
model Booking {
  id                String        @id @default(cuid())
  userId            String?       // Optional: Link to registered user
  user              User?         @relation(fields: [userId], references: [id])
  eventId           String
  event             Event         @relation(fields: [eventId], references: [id])
  quantity          Int
  totalPrice        Float
  status            BookingStatus @default(PENDING)
  deliveryName      String?       // Name for ticket delivery/pickup
  deliveryEmail     String?       // Email for e-ticket delivery
  deliveryPhone     String?       // Phone number for contact/delivery
  utr               String?       @unique // UPI Transaction Reference (set after payment)
  paymentVerifiedAt DateTime?     // Timestamp when admin verified the payment
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([eventId])
  @@index([status])
}

// Enum for Event Status
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// Enum for Booking Status
enum BookingStatus {
  PENDING     // Initial state after creation, before payment attempt
  PROCESSING  // UTR submitted, awaiting admin verification
  CONFIRMED   // Payment verified, ticket issued
  CANCELLED   // Booking cancelled (by user or system)
  FAILED      // Payment verification failed
}

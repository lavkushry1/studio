// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizedEvents Event[]        @relation("OrganizedBy")
  bookings        Booking[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[] // Relation to audit logs created by this user
}

enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String // Stores reference ID, not the actual JWT token
  expiresAt DateTime
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade delete tokens if user is deleted

  createdAt DateTime @default(now())

  @@index([userId])
}

model Event {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  category        String?          // Added category
  date            DateTime
  location        String
  imageUrl        String?
  status          EventStatus      @default(DRAFT)
  hasSeatMap      Boolean          @default(false) // Flag for seat map events
  organizerId     String           @db.ObjectId
  organizer       User             @relation("OrganizedBy", fields: [organizerId], references: [id])
  ticketCategories TicketCategory[]
  seats           Seat[]           // Relation to seats for this event
  bookings        Booking[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizerId])
  @@index([date])
  @@index([location])
  @@index([status])
  @@index([category]) // Added index for category
   // Add compound index for text search
   @@fulltext([title, description, location, category]) // Specify fields to index for text search
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model TicketCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  price     Float
  totalQty  Int
  bookedQty Int      @default(0)
  eventId   String   @db.ObjectId
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade) // Cascade delete categories if event is deleted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model Seat {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  row       String // e.g., "A", "B", "GA1"
  number    Int // e.g., 1, 2, 101
  section   String? // e.g., "North Stand", "Block C", "Orchestra"
  status    SeatStatus @default(AVAILABLE)
  eventId   String     @db.ObjectId
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingId String?    @db.ObjectId // Link to the booking that includes this seat
  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull) // Set null if booking is deleted
  reservedAt DateTime? // Timestamp when seat was reserved
  price     Float?     // Optional price override specific to this seat

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([eventId, section, row, number]) // Ensure unique seat within an event
  @@index([eventId])
  @@index([eventId, status])
  @@index([bookingId])
}

enum SeatStatus {
  AVAILABLE
  RESERVED // Temporarily held during checkout
  BOOKED // Confirmed booking
  UNAVAILABLE // Blocked by organizer, not for sale
}

model Booking {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String?       @db.ObjectId // Optional: for anonymous bookings
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull) // Don't delete booking if user deleted
  eventId           String        @db.ObjectId
  event             Event         @relation(fields: [eventId], references: [id])
  quantity          Int // Number of tickets/seats
  totalPrice        Float
  status            BookingStatus @default(PENDING)
  deliveryName      String? // Name for ticket delivery/pickup
  deliveryEmail     String? // Email for e-ticket delivery
  deliveryPhone     String? // Phone for delivery updates
  utr               String?       @unique // UPI Transaction Reference, unique
  paymentVerifiedAt DateTime? // Timestamp when admin verified payment
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  seats             Seat[] // Relation to specific seats booked (if applicable)

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([createdAt]) // Index for timeout checks
}

enum BookingStatus {
  PENDING // Initial state, awaiting payment/UTR
  PROCESSING // UTR submitted, awaiting admin verification
  CONFIRMED // Payment verified, ticket issued
  CANCELLED // Booking cancelled by user or system (timeout)
  FAILED // Payment rejected by admin or failed
}

model UpiSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  upiId     String   @unique // The actual UPI VPA (e.g., business@bank)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // updatedByAdminId String? @db.ObjectId // Optional: Track which admin last updated

  @@index([isActive])
}

// New Model for Audit Logging
model AuditLog {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  action        String // e.g., "Payment Approved", "Event Updated", "User Role Changed"
  entity        String // e.g., "Booking", "Event", "User"
  entityId      String // ID of the entity affected
  userId        String // ID of the user performing the action (or "SYSTEM")
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull) // Link to user if not system
  timestamp     DateTime  @default(now())
  details       String? // More context about the action
  previousValue Json? // Store previous state as JSON
  newValue      Json? // Store new state as JSON

  @@index([entity, entityId])
  @@index([userId])
  @@index([timestamp])
  @@index([action])
}

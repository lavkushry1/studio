# .env.development
# DO NOT COMMIT THIS FILE TO VERSION CONTROL if it contains real secrets

# Application Port (Optional, defaults in code)
# PORT=3001

# Database Connection URL (Update with your actual development DB URL)
# Example for SQLite (as in schema.prisma):
DATABASE_URL="file:../prisma/dev.db"
# Example for PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
# Example for MySQL:
# DATABASE_URL="mysql://user:password@localhost:3306/mydb"


# JWT Secrets (CHANGE THESE to strong, random strings)
ACCESS_TOKEN_SECRET="your_super_secret_access_key_for_dev"
REFRESH_TOKEN_SECRET="your_even_more_secret_refresh_key_for_dev"

# JWT Expiration Times (Optional, defaults in jwt.utils.ts)
# ACCESS_TOKEN_EXPIRATION="15m"  # 15 minutes
# REFRESH_TOKEN_EXPIRATION="7d" # 7 days


# Add other environment-specific variables here
NODE_ENV=development

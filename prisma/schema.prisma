// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  email           String        @unique
  password        String
  name            String?
  role            UserRole      @default(USER)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organizedEvents Event[]       @relation("OrganizerEvents") // Events organized by this user
  bookings        Booking[] // Bookings made by this user
  refreshTokens   RefreshToken[] // User's refresh tokens
}

enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

model Event {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String
  category         String? // Added category field
  date             DateTime
  location         String
  imageUrl         String?
  status           EventStatus      @default(DRAFT)
  organizerId      String           @db.ObjectId
  organizer        User             @relation("OrganizerEvents", fields: [organizerId], references: [id])
  ticketCategories TicketCategory[]
  seats            Seat[] // Seats associated with this event
  bookings         Booking[] // Bookings for this event
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([date])
  @@index([location])
  @@index([status])
  @@index([category]) // Index category
  @@fulltext([title, description, location, category]) // Add category to full-text index
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model TicketCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   // e.g., "General Admission", "VIP"
  price     Float
  totalQty  Int // Total available tickets in this category (for quantity-based events)
  bookedQty Int    @default(0) // Number of tickets booked in this category
  eventId   String   @db.ObjectId
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade) // Ensure cascade delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model Seat {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  row        String // e.g., "A", "10"
  number     Int    // e.g., 1, 2, 15
  section    String? // e.g., "North Stand", "Block C"
  status     SeatStatus  @default(AVAILABLE)
  eventId    String      @db.ObjectId
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingId  String?     @db.ObjectId // Link to the booking if booked
  booking    Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull) // Set null if booking deleted
  reservedAt DateTime? // Timestamp when the seat was reserved

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure a seat is unique within an event
  @@unique([eventId, section, row, number])
  @@index([eventId, status])
  @@index([bookingId])
}

enum SeatStatus {
  AVAILABLE
  RESERVED // Temporarily held during checkout
  BOOKED // Confirmed booking
  UNAVAILABLE // Physically unavailable, blocked by organizer
}

model Booking {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String?       @db.ObjectId // Optional: Link to registered user
  user              User?         @relation(fields: [userId], references: [id])
  eventId           String        @db.ObjectId
  event             Event         @relation(fields: [eventId], references: [id])
  quantity          Int // Number of tickets/seats booked
  totalPrice        Float
  status            BookingStatus @default(PENDING)
  deliveryName      String? // Name for ticket delivery/pickup
  deliveryEmail     String? // Email for e-ticket delivery
  deliveryPhone     String? // Phone for delivery communication
  utr               String?       @unique // UPI Transaction Reference (Unique)
  paymentVerifiedAt DateTime?   // Timestamp when admin verified payment
  seats             Seat[] // Seats associated with this booking (for seat-based events)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([eventId, status])
  @@index([userId]) // Index for user's bookings
  @@index([status]) // Index for finding bookings by status (e.g., PENDING, PROCESSING)
  @@index([utr]) // Index on UTR for faster lookup
}

enum BookingStatus {
  PENDING // Initial state after booking creation, before payment started/UTR submitted
  PROCESSING // UTR submitted, awaiting admin verification
  CONFIRMED // Payment verified, booking successful
  CANCELLED // Booking cancelled (e.g., timeout, user action)
  FAILED // Payment failed or rejected by admin
}

// Model for storing refresh tokens
model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique // Store a hash or identifier, not the raw token
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Or your chosen provider (mysql, mongodb, etc.)
  url      = env("DATABASE_URL")
}

// ========== User Model ==========
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizedEvents Event[]        @relation("OrganizerEvents")
  bookings        Booking[]      @relation("UserBookings")
  refreshTokens   RefreshToken[] @relation("UserRefreshTokens") // Relation to refresh tokens

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  // Add ORGANIZER if needed later
}

// ========== Refresh Token Model ==========
model RefreshToken {
  id        String   @id @default(cuid())
  token     String // Storing the ID/reference, not the full JWT
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relation to User
  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade) // Cascade delete tokens if user is deleted

  @@unique([userId, token]) // Ensure a user doesn't have duplicate token references
  @@map("refresh_tokens")
}


// ========== Event Model ==========
model Event {
  id            String           @id @default(cuid())
  title         String
  description   String
  date          DateTime
  location      String
  imageUrl      String?
  status        EventStatus      @default(DRAFT)
  organizerId   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  organizer       User             @relation("OrganizerEvents", fields: [organizerId], references: [id])
  ticketCategories TicketCategory[] @relation("EventCategories")
  bookings        Booking[]        @relation("EventBookings")

  @@map("events")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// ========== Ticket Category Model ==========
model TicketCategory {
  id        String   @id @default(cuid())
  name      String
  price     Float
  totalQty  Int
  bookedQty Int      @default(0) // Track booked tickets for availability
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation
  event Event @relation("EventCategories", fields: [eventId], references: [id], onDelete: Cascade) // Cascade delete categories if event is deleted

  @@map("ticket_categories")
}


// ========== Booking Model ==========
model Booking {
  id                String        @id @default(cuid())
  userId            String?       // Optional: for anonymous bookings
  eventId           String
  quantity          Int
  totalPrice        Float
  status            BookingStatus @default(PENDING)
  // Delivery details (consider normalizing if more complex address needed)
  deliveryName      String?
  deliveryEmail     String?
  deliveryPhone     String?
  // Payment details
  utr               String?       @unique // Unique Transaction Reference
  paymentVerifiedAt DateTime?     // Timestamp when admin verified payment
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  user  User?  @relation("UserBookings", fields: [userId], references: [id], onDelete: SetNull) // Set userId to null if user deleted
  event Event  @relation("EventBookings", fields: [eventId], references: [id])

  @@map("bookings")
}

enum BookingStatus {
  PENDING     // Initial state after creation
  PROCESSING  // UTR submitted, awaiting admin verification
  CONFIRMED   // Payment verified, ticket issued (or ready)
  CANCELLED   // Booking cancelled by user or system
  FAILED      // Payment verification failed/rejected by admin
}


// Consider adding models for Venues/Stadiums, Teams, Discounts later

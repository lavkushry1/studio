// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Define User roles
enum UserRole {
  USER
  ADMIN
  ORGANIZER // Added Organizer role
}

// User model
model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  email         String         @unique
  password      String
  name          String?
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[] // Relation to refresh tokens
  organizedEvents Event[]      @relation("OrganizedBy") // Events organized by this user
  bookings      Booking[]      @relation("BookedBy") // Bookings made by this user

  // TODO: Add profile fields (address, phone, etc.) if needed
}

// Refresh token model for session management
model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String // Used as a marker/reference, not storing the raw JWT
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation to User
  expiresAt DateTime // Expiration date for the refresh token

  @@index([userId])
}


// Event model
model Event {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  description      String
  category         String?          // Added category field
  date             DateTime
  location         String
  imageUrl         String?
  status           EventStatus      @default(DRAFT)
  organizerId      String           @db.ObjectId
  organizer        User             @relation("OrganizedBy", fields: [organizerId], references: [id]) // Relation to User (organizer)
  ticketCategories TicketCategory[] // Relation to Ticket Categories
  seats            Seat[]           // Relation to Seats
  bookings         Booking[]        // Relation to Bookings
  hasSeatMap       Boolean          @default(false) // Flag to indicate if seat map is used

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([organizerId])
  @@index([date])
  @@index([location])
  @@index([category])
  @@index([status])
  @@fulltext([title, description, location, category]) // Add text index for search
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// Ticket category model
model TicketCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  price     Float
  totalQty  Int      // Total quantity available for this category
  bookedQty Int      @default(0) // Quantity already booked (for quantity-based events)
  eventId   String   @db.ObjectId
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade) // Relation to Event
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// Seat model for events with seat maps
model Seat {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  row        String
  number     Int
  section    String?    // e.g., 'North Stand', 'Block A'
  status     SeatStatus @default(AVAILABLE)
  eventId    String     @db.ObjectId
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingId  String?    @db.ObjectId // Link to the booking if booked
  booking    Booking?   @relation("BookedSeats", fields: [bookingId], references: [id], onDelete: SetNull) // Relation to Booking
  reservedAt DateTime?  // Timestamp when the seat was reserved

  price      Float?     // Optional: Price specific to this seat (if overriding category price)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([eventId, section, row, number]) // Ensure seat uniqueness within an event
  @@index([eventId])
  @@index([eventId, status])
  @@index([bookingId])
}

enum SeatStatus {
  AVAILABLE
  RESERVED    // Temporarily held during booking process
  BOOKED      // Confirmed booking
  UNAVAILABLE // Blocked, not for sale
}


// Booking model
model Booking {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String?       @db.ObjectId // Nullable if anonymous booking allowed
  user              User?         @relation("BookedBy", fields: [userId], references: [id], onDelete: SetNull) // Relation to User
  eventId           String        @db.ObjectId
  event             Event         @relation(fields: [eventId], references: [id]) // Relation to Event
  quantity          Int           // Number of tickets/seats booked
  totalPrice        Float         // Total price for the booking
  status            BookingStatus @default(PENDING) // Status of the booking
  seats             Seat[]        @relation("BookedSeats") // Seats associated with this booking (if seat-based)
  deliveryName      String?       // Added for delivery/ticket holder info
  deliveryEmail     String?       // Added for delivery/ticket holder info
  deliveryPhone     String?       // Added for delivery/ticket holder info
  utr               String?       @unique // Added UTR field, make it unique
  paymentVerifiedAt DateTime?   // Added timestamp for verification

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([eventId])
  @@index([status])
}

enum BookingStatus {
  PENDING     // Initial state after creation or seat reservation
  PROCESSING  // UTR submitted, awaiting admin verification
  CONFIRMED   // Payment verified, booking complete
  CANCELLED   // Booking cancelled by user or system (timeout)
  FAILED      // Payment failed or rejected by admin
}


// UPI Settings Model (Singleton-like, stores the active VPA)
model UpiSetting {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  upiId           String    @unique // The Virtual Payment Address (VPA)
  isActive        Boolean   @default(true) // Only one setting should be active
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Optional: Add fields for who last updated it (Admin ID)
  // updatedByAdminId String? @db.ObjectId
}
